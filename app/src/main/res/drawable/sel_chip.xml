<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/accent" /><corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="@color/accent" /><corners android:radius="18dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/chip" /><corners android:radius="18dp" /></shape>
    </item>
</selector>
