<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 纯视频背景：全屏播放器 -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000" />

    <!-- 菜单呼出时对视频做半透明压暗（不做模糊） -->
    <View
        android:id="@+id/videoDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:alpha="0"
        android:visibility="gone" />

    <!-- 双栏菜单：左导航栏(贴边整块) + 频道卡(悬浮圆角) -->
    <FrameLayout
        android:id="@+id/menuRoot"
        android:layout_width="@dimen/menu_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/navPanel"
            android:layout_width="@dimen/nav_width"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:orientation="vertical"
            android:background="@color/panel">

            <TextView
                android:id="@+id/tvBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="18dp"
                android:paddingBottom="14dp"
                android:text="@string/app_name"
                android:textColor="@color/fg"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/navList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:listSelector="@null"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingBottom="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardPanel"
            android:layout_width="@dimen/card_width"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:layout_marginStart="170dp"
            android:layout_marginTop="@dimen/menu_margin_v"
            android:layout_marginBottom="@dimen/menu_margin_v"
            android:elevation="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card">

            <TextView
                android:id="@+id/tvCardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/dim"
                android:textSize="18sp" />

            <ListView
                android:id="@+id/channelList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:listSelector="@drawable/sel_channel"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/tvHintBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#14FFFFFF"
                android:padding="10dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/dim"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 小提示胶囊（切线路 / 收藏 / 越界提示），不再有左上角频道名大字 -->
    <TextView
        android:id="@+id/tvToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_pill"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:textColor="@color/fg"
        android:textSize="18sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/statusBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/bg">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:textColor="@color/fg"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/dim"
            android:textSize="20sp" />
    </LinearLayout>
</FrameLayout>
