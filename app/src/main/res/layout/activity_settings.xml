<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="@color/fg"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="直播源订阅（m3u 或 txt 地址，每行一条）"
            android:textColor="@color/accent"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/etSubs"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="8dp"
            android:background="#FF151B24"
            android:gravity="top|start"
            android:inputType="textUri|textMultiLine"
            android:padding="12dp"
            android:textColor="@color/fg"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="节目单 EPG 地址（xmltv，每行一条，可留空）"
            android:textColor="@color/accent"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/etEpg"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="8dp"
            android:background="#FF151B24"
            android:gravity="top|start"
            android:inputType="textUri|textMultiLine"
            android:padding="12dp"
            android:textColor="@color/fg"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="自定义 User-Agent（留空用默认）"
            android:textColor="@color/accent"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/etUa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FF151B24"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="@color/fg"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保存并刷新"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnSaveOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="仅保存"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnReloadEpg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="刷新节目单"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnManageGroups"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="分组管理"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="网络（DNS over HTTPS，防 DNS 污染/劫持）"
            android:textColor="@color/accent"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Switch
                android:id="@+id/swDoh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="启用 DoH"
                android:textColor="@color/fg"
                android:textSize="20sp" />

            <RadioGroup
                android:id="@+id/rgDoh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbDohPub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="doh.pub"
                    android:textColor="@color/fg"
                    android:textSize="20sp" />

                <RadioButton
                    android:id="@+id/rbDohAli"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="alidns"
                    android:textColor="@color/fg"
                    android:textSize="20sp" />

                <RadioButton
                    android:id="@+id/rbDoh360"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="360"
                    android:textColor="@color/fg"
                    android:textSize="20sp" />
            </RadioGroup>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDohState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/dim"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvV6State"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/dim"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnCheckUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="检查更新"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnDoUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="一键更新"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/dim"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="手机配置页：手机连同一WiFi，用浏览器打开下面地址即可远程修改直播源"
            android:textColor="@color/dim"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvLocalIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/accent"
            android:textSize="22sp" />
    </LinearLayout>
</ScrollView>
